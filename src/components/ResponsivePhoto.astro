---
import type { ImageMetadata } from 'astro';
import { renderPhoto } from '../lib/photos';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { image, alt, sizes, eager = false } = Astro.props;
const photo = await renderPhoto(image);
---

<img
  src={photo.src}
  srcset={photo.srcset}
  {sizes}
  {alt}
  width={image.width}
  height={image.height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
